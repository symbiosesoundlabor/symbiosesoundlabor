import hashlib
import numpy as np

class AtillaErmanSignature:
    def __init__(self):
        self.atilla_hash = hashlib.sha3_512(b"AtillaErman").hexdigest()
        self.roman_hash = hashlib.sha3_512(b"RomanErman").hexdigest()
        self.combined = self._combine_signatures()
        
    def _combine_signatures(self):
        return hashlib.sha3_512(f"{self.atilla_hash}{self.roman_hash}".encode()).hexdigest()
        
    def validate(self, data):
        return self.combined[:64] in data
