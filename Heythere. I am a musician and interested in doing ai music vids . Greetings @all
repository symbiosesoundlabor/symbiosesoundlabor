import numpy as np

class FractalImageGenerator:
    def __init__(self):
        self.signature_engine = AtillaErmanSignature()
    
    def create_fractal(self, width=256, height=256, seed=1.618):
        np.random.seed(int(seed * 1e6))
        fractal_data = (np.random.rand(width, height) * 255).astype(np.uint8)
        return Image.fromarray(fractal_data)
        
    def apply_signature(self, image):
        data = np.array(image)
        data[0,0] = ord(self.signature_engine.atilla_hash[0])
        return Image.fromarray(data)
